      "checkConstraints": {
        "accounts_login_pair": {
          "name": "accounts_login_pair",
          "value": "(\"accounts\".\"login\" is null) = (\"accounts\".\"login_canonical\" is null)"
        },
        "accounts_login_format": {
          "name": "accounts_login_format",
          "value": "\"accounts\".\"login\" ~ '^[A-Za-z0-9_-]{3,32}$' and \"accounts\".\"login_canonical\" = lower(\"accounts\".\"login\")"
        },
        "accounts_password_requires_login": {
          "name": "accounts_password_requires_login",
          "value": "\"accounts\".\"password_hash\" is null or \"accounts\".\"login_canonical\" is not null"
        },
        "accounts_password_hash_not_empty": {
          "name": "accounts_password_hash_not_empty",
          "value": "\"accounts\".\"password_hash\" is null or \"accounts\".\"password_hash\" <> ''"
        },
        "accounts_password_hash_format": {
          "name": "accounts_password_hash_format",
          "value": "\"accounts\".\"password_hash\" is null or \"accounts\".\"password_hash\" ~ '^scrypt\\$[0-9]{2}\\$[0-9]{1,2}\\$[0-9]\\$[A-Za-z0-9_-]{22}\\$[A-Za-z0-9_-]{43}$'"
        },
        "accounts_session_version_positive": {
          "name": "accounts_session_version_positive",
          "value": "\"accounts\".\"session_version\" >= 1"
        },
        "accounts_display_name_length": {
          "name": "accounts_display_name_length",
          "value": "char_length(\"accounts\".\"display_name\") between 1 and 40 and btrim(\"accounts\".\"display_name\") <> ''"
        }
