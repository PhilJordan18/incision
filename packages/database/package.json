    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@incision/domain": "^0.1.0",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
