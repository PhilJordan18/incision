# Copy to .env for local development; never commit .env. Production values live in
# Azure App Service app settings and GitHub environment secrets (docs/DEPLOYMENT.md).

# Local PostgreSQL started by Docker Compose. Never reuse this password in production.
INCISION_DB_PASSWORD=incision_local_only

# Application database URL. Production: Neon pooled URL (host contains "-pooler") with
# sslmode=verify-full (pg treats "require" as verify-full today and warns at start-up).
DATABASE_URL=postgresql://incision:incision_local_only@localhost:5432/incision
# Direct (unpooled) URL used only by migrations (npm run db:migrate -w @incision/database).
# Production: Neon direct URL, held by the GitHub environment "production", never by the app.
DATABASE_URL_UNPOOLED=postgresql://incision:incision_local_only@localhost:5432/incision

# Disposable server for database tests only (docker compose up -d db-test). Must be localhost:
# the tests create and drop temporary databases there. Never DATABASE_URL or Neon.
TEST_DATABASE_URL=postgresql://incision_test:incision_test_only@localhost:5433/postgres

# Public URL of the site; WebSocket handshakes from any other origin are refused.
# Optional locally (defaults to http://localhost:$PORT); required in production.
APP_URL=http://localhost:3000
# HTTP port. App Service provides it in production.
PORT=3000
