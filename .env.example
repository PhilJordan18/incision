# Copy to .env for local development; never commit .env. Production values live in
# Azure App Service app settings and GitHub environment secrets (docs/DEPLOYMENT.md).

# Local PostgreSQL started by Docker Compose. Never reuse this password in production.
INCISION_DB_PASSWORD=incision_local_only

# Application database URL. Production: Neon pooled URL (host contains "-pooler") with
# sslmode=verify-full (pg treats "require" as verify-full today and warns at start-up).
DATABASE_URL=postgresql://incision:incision_local_only@localhost:5432/incision
# Direct (unpooled) URL used only by migrations (npm run db:migrate -w @incision/database).
# Production: Neon direct URL, held by the GitHub environment "production", never by the app.
DATABASE_URL_UNPOOLED=postgresql://incision:incision_local_only@localhost:5432/incision

# Disposable server for database tests only (docker compose up -d db-test). Must be localhost:
# the tests create and drop temporary databases there. Never DATABASE_URL or Neon. Vitest does
# not read .env: pass it inline, e.g. TEST_DATABASE_URL=... npm run test:db -w @incision/database
TEST_DATABASE_URL=postgresql://incision_test:incision_test_only@localhost:5433/postgres

# Pooled URL of a Neon branch for `npm run db:check-pooled -w @incision/database` only. Never in
# .env, never on the command line: typed at the prompt (docs/DEPLOYMENT.md, "Connexions et transactions").
# POOLED_CHECK_URL=

# Public URL of the site; WebSocket handshakes from any other origin are refused.
# Optional locally (defaults to http://localhost:$PORT); required in production.
APP_URL=http://localhost:3000
# HTTP port. App Service provides it in production.
PORT=3000

# --- Authentication (Auth.js, ADR-0003) ---------------------------------------------------
# Public URL Auth.js builds its callbacks from: same origin as APP_URL, no path.
AUTH_URL=http://localhost:3000
# Encrypts the session cookie; 32+ characters. Generate one per environment, never reuse
# or commit it: openssl rand -base64 32
AUTH_SECRET=
# OAuth apps (docs/DEPLOYMENT.md, "Authentication"): GitHub with no scope, Discord with
# "identify". Local callbacks: http://localhost:3000/api/auth/callback/github and
# http://localhost:3000/api/auth/callback/discord. Values come from the providers' consoles.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Reverse proxies whose X-Forwarded-For entry is trusted for per-address rate limits:
# 0 locally (the TCP peer is the client), 1 on App Service (its front end). Required in production.
TRUSTED_PROXY_HOPS=0

# --- End-to-end tests (optional; read by apps/web/playwright.config.ts) -------------------
# Local incision_e2e* database, dropped and rebuilt with the demo accounts at every run.
# E2E_DATABASE_URL=postgresql://incision_test:incision_test_only@localhost:5433/incision_e2e
# Port of the production build the tests start (default 3200).
# E2E_PORT=3200
# apps/web folder of an unpacked release archive, to test exactly what is deployed.
# E2E_SERVER_DIR=
# E2E_AUTH_SECRET is generated for each run; set it only to reuse cookies across runs.
